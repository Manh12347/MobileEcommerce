# Shell scripts chạy trên Linux
*.sh text eol=lf

# GitHub Actions
*.yml text eol=lf
*.yaml text eol=lf

# Docker
Dockerfile text eol=lf

# Environment files
.env text eol=lf
.env.example text eol=lf
.env.* text eol=lf

# Config files
*.json text eol=lf
