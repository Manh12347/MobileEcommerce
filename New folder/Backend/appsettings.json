{
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Database=${DB_DATABASE};Username=${DB_USERNAME};Password=${DB_PASSWORD};Persist Security Info=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EmailSettings": {
    "SmtpServer": "${EMAIL_SMTP_SERVER}",
    "SmtpPort": "${EMAIL_SMTP_PORT}",
    "SenderEmail": "${EMAIL_SENDER_EMAIL}",
    "SenderName": "${EMAIL_SENDER_NAME}",
    "AppPassword": "${EMAIL_APP_PASSWORD}",
    "EnableSsl": "${EMAIL_ENABLE_SSL}"
  },
  "SepayConfig": {
    "AccountNumber": "${SEPAY_ACCOUNT_NUMBER}",
    "BankName": "${SEPAY_BANK_NAME}"
  },
  "HooksConfig": {
    "ApiKey": "${HOOKS_API_KEY}",
    "OrderIdPattern": "${HOOKS_ORDER_ID_PATTERN}",
    "AmountTolerance": "${HOOKS_AMOUNT_TOLERANCE}"
  }
}
